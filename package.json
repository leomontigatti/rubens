{
  "name": "underthing",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "^22.23.4"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node --import tsx scripts/worktree-port.ts && vp dev",
    "dev:url": "node --import tsx scripts/worktree-port.ts --print",
    "dev:stop": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/dev-stop.ts",
    "build": "vp build",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "typecheck": "vp check --no-fmt --no-lint",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "routes:generate": "tsr generate",
    "test": "pnpm test:unit && pnpm test:workers",
    "test:unit": "vp test --run --project unit",
    "test:e2e": "pnpm build && node --import tsx tests/e2e/prepare.ts && playwright test",
    "eval:assistant": "node --env-file-if-exists=.env.local --import ./tests/evals/src-imports.ts tests/evals/assistant/run.ts",
    "eval:voice": "node --env-file-if-exists=.env.local --import ./tests/evals/src-imports.ts tests/evals/assistant/voice/run.ts",
    "eval:report": "node --import ./tests/evals/src-imports.ts tests/evals/assistant/report.ts",
    "check:dependency-audit": "node scripts/check-dependency-audit.mjs",
    "check:pr-title": "node --import tsx scripts/check-pr-title.ts",
    "check:labels": "node --import tsx scripts/check-labels.ts",
    "check:comment-language": "node --import tsx scripts/check-comment-language.ts",
    "check:file-tokens": "node --import tsx scripts/check-file-tokens.ts",
    "check:fallow": "fallow audit --quiet --gate-marker agent --base origin/main",
    "check:dupes": "fallow dupes --quiet",
    "labels:sync": "node --import tsx scripts/sync-labels.ts",
    "setup:organization": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/setup-organization.ts",
    "prepare": "vp config --no-agent || true",
    "organization:generate": "node node_modules/drizzle-kit/bin.cjs generate --config drizzle.organization.config.ts --name organization",
    "test:workers": "vp test --run --project workers"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@clerk/backend": "3.27.0",
    "@clerk/localizations": "4.24.6",
    "@clerk/react": "6.18.6",
    "@date-fns/tz": "^1.5.0",
    "@tanstack/ai": "^1.2.0",
    "@tanstack/ai-anthropic": "^1.1.1",
    "@tanstack/ai-cloudflare": "^1.2.0",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.0",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.4",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/vitest-plugin": "1.6.0",
    "@cloudflare/workers-types": "5.20261104.1",
    "@playwright/test": "1.64.1",
    "@shadcn/lint": "0.2.5",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/ai-gemini": "^1.1.1",
    "@tanstack/ai-openai": "^1.1.1",
    "@tanstack/router-cli": "^1.167.46",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "fallow": "^3.39.0",
    "jsdom": "^30.1.3",
    "promptfoo": "^0.125.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plus": "^1.4.0",
    "wrangler": "4.158.0"
  }
}
