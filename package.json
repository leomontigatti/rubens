{
  "name": "rubens",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "^22.23.2"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/worktree-db.ts ensure && vp dev",
    "dev:stop": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/dev-stop.ts",
    "build": "vp build",
    "start": "node .output/server/index.mjs",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "typecheck": "vp check --no-fmt --no-lint",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "routes:generate": "tsr generate",
    "test": "pnpm test:unit && pnpm test:db",
    "test:unit": "vp test --run --project unit",
    "test:db": "vp test --run --project db",
    "check:migrations": "node scripts/check-migration-immutability.mjs && node scripts/check-migration-order.mjs && node scripts/check-migration-safety.mjs",
    "check:dependency-audit": "node scripts/check-dependency-audit.mjs",
    "check:pr-title": "node --import tsx scripts/check-pr-title.ts",
    "db:generate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/worktree-db.ts ensure && node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:studio": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs studio",
    "db:worktree": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/worktree-db.ts",
    "prepare": "vp config --no-agent || true"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.100.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-router-ssr-query": "^1.167.0",
    "@tanstack/react-start": "^1.168.0",
    "@tanstack/react-table": "^9.2.0",
    "@tanstack/react-virtual": "^3.14.0",
    "better-auth": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.53.0",
    "nitro": "3.0.260610-beta",
    "pg": "^8.16.3",
    "pg-boss": "^12.30.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rrule": "^2.8.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.2",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plus": "^1.1.0"
  }
}
