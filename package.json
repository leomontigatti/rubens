{
  "name": "underthing",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "^26.13.1"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node --import tsx scripts/worktree-port.ts && vp dev",
    "dev:url": "node --import tsx scripts/worktree-port.ts --print",
    "dev:stop": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/dev-stop.ts",
    "build": "vp build",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "typecheck": "vp check --no-fmt --no-lint",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "routes:generate": "tsr generate",
    "types:generate": "rm -f worker-configuration.d.ts && wrangler types --include-env=false",
    "check:worker-types": "mkdir -p node_modules/.cache && rm -f node_modules/.cache/worker-configuration.d.ts && wrangler types --include-env=false node_modules/.cache/worker-configuration.d.ts > /dev/null && cmp -s worker-configuration.d.ts node_modules/.cache/worker-configuration.d.ts || { echo 'worker-configuration.d.ts is not what pnpm types:generate writes: run it and commit the result' >&2; exit 1; }",
    "test": "pnpm test:unit && pnpm test:workers",
    "test:unit": "vp test --run --project unit",
    "test:e2e": "pnpm build && node --import tsx tests/e2e/prepare.ts && playwright test",
    "eval:assistant": "node --env-file-if-exists=.env.local tests/evals/assistant/run.ts",
    "eval:voice": "node --env-file-if-exists=.env.local tests/evals/assistant/voice/run.ts",
    "eval:template-review": "node --env-file-if-exists=.env.local tests/evals/assistant/template-review.ts",
    "eval:report": "node tests/evals/assistant/report.ts",
    "check:dependency-audit": "node scripts/check-dependency-audit.mjs",
    "check:pr-title": "node --import tsx scripts/check-pr-title.ts",
    "check:labels": "node --import tsx scripts/check-labels.ts",
    "check:comment-language": "node --import tsx scripts/check-comment-language.ts",
    "check:file-tokens": "node --import tsx scripts/check-file-tokens.ts",
    "check:type-assertions": "node --import tsx scripts/check-type-assertions.ts",
    "check:migrations": "node --import tsx scripts/check-migrations.ts",
    "check:fallow": "fallow audit --quiet --gate-marker agent --base origin/main",
    "check:dupes": "fallow dupes --quiet",
    "labels:sync": "node --import tsx scripts/sync-labels.ts",
    "setup:organization": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/setup-organization.ts",
    "prepare": "vp config --no-agent || true",
    "organization:generate": "node node_modules/drizzle-kit/bin.cjs generate --config drizzle.organization.config.ts --name organization",
    "test:workers": "vp test --run --project workers"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@clerk/backend": "3.31.4",
    "@clerk/localizations": "4.26.3",
    "@clerk/react": "6.19.4",
    "@date-fns/tz": "^1.5.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/ai": "^1.8.0",
    "@tanstack/ai-anthropic": "^1.2.1",
    "@tanstack/ai-cloudflare": "^1.2.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.7",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.4",
    "libphonenumber-js": "^1.13.16",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "@cloudflare/vitest-plugin": "1.9.0",
    "@cloudflare/workers-types": "5.20261121.1",
    "@nkzw/oxlint-config": "^3.0.2",
    "@playwright/test": "1.65.1",
    "@shadcn/lint": "0.2.5",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/ai-gemini": "^1.3.0",
    "@tanstack/ai-openai": "^1.2.0",
    "@tanstack/router-cli": "^1.168.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "fallow": "^3.46.0",
    "jsdom": "^30.1.3",
    "oxc-parser": "0.148.0",
    "promptfoo": "^0.125.1",
    "shadcn": "^4.23.0",
    "skills": "1.9.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plus": "^1.7.0",
    "wrangler": "4.166.0"
  }
}
