{
  "name": "rubens",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "^22.23.4"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/worktree-db.ts ensure && vp dev",
    "dev:stop": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/dev-stop.ts",
    "build": "vp build",
    "start": "node .output/server/index.mjs",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "typecheck": "vp check --no-fmt --no-lint",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "routes:generate": "tsr generate",
    "test": "pnpm test:unit && pnpm test:db",
    "test:unit": "vp test --run --project unit",
    "test:db": "vp test --run --project db",
    "test:e2e": "pnpm build && node --import tsx tests/e2e/prepare.ts && playwright test",
    "check:migrations": "node scripts/check-migration-immutability.mjs && node scripts/check-migration-order.mjs && node scripts/check-migration-safety.mjs",
    "check:dependency-audit": "node scripts/check-dependency-audit.mjs",
    "check:pr-title": "node --import tsx scripts/check-pr-title.ts",
    "check:labels": "node --import tsx scripts/check-labels.ts",
    "check:comment-language": "node --import tsx scripts/check-comment-language.ts",
    "check:file-tokens": "node --import tsx scripts/check-file-tokens.ts",
    "check:fallow": "fallow audit --quiet --gate-marker agent --base origin/main",
    "db:generate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/worktree-db.ts ensure && node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:studio": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs studio",
    "db:worktree": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/worktree-db.ts",
    "labels:sync": "node --import tsx scripts/sync-labels.ts",
    "setup:organization": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/setup-organization.ts",
    "prepare": "vp config --no-agent || true",
    "organization:generate": "node node_modules/drizzle-kit/bin.cjs generate --config drizzle.organization.config.ts --name organization",
    "test:workers": "vp test --run --project workers"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@clerk/backend": "3.26.5",
    "@clerk/localizations": "4.24.4",
    "@clerk/react": "6.18.4",
    "@date-fns/tz": "^1.5.0",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.0",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-table": "^9.3.1",
    "better-auth": "^1.7.14",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.4",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.62.0",
    "pg": "^8.16.3",
    "pg-boss": "^12.38.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/vitest-plugin": "1.5.0",
    "@cloudflare/workers-types": "5.20261102.1",
    "@electric-sql/pglite": "^0.5.12",
    "@playwright/test": "1.64.1",
    "@shadcn/lint": "0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.46",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.11",
    "fallow": "^3.37.0",
    "jsdom": "^30.1.3",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plus": "^1.4.0",
    "wrangler": "4.156.2"
  }
}
