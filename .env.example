# Nothing here is required: with no Clerk keys, `pnpm dev` signs in through
# the dev sign-in (docs/operations/local-development.md).

# Dev server port. A worktree's .env.local overrides it (`pnpm dev` writes it).
PORT="3000"

# Clerk, to sign in through Clerk locally instead of the dev sign-in. A deployed
# Worker reads them as Worker secrets (docs/operations/infrastructure.md).
# CLERK_PUBLISHABLE_KEY="pk_test_..."
# CLERK_SECRET_KEY="sk_test_..."

# Meta's WhatsApp webhook (/api/whatsapp). A deployed Worker reads them as
# Worker secrets (docs/operations/infrastructure.md).
# META_APP_SECRET="..."
# WHATSAPP_VERIFY_TOKEN="..."
# WHATSAPP_PHONE_NUMBER_ID="..."
# WHATSAPP_ORGANIZATION_ID="..."
