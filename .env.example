# Two URLs, one database (ADR-0002). DATABASE_URL is the app role, the one RLS
# applies to and the one a connection pooler would front. DATABASE_DIRECT_URL is
# the owner role, always direct: migrations and pg-boss use it.
DATABASE_URL="postgres://rubens_app:rubens_app@localhost:5434/rubens"
DATABASE_DIRECT_URL="postgres://postgres:postgres@localhost:5434/rubens"

# Dev server port. A worktree's .env.local overrides it (`pnpm db:worktree`).
PORT="3000"

# Better Auth. BETTER_AUTH_SECRET signs sessions: `openssl rand -base64 32`,
# one per environment. BETTER_AUTH_URL is the app's public origin.
BETTER_AUTH_SECRET="replace-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
